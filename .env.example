# Azure OpenAI Configuration
AZURE_OPENAI_O1MINI_API_KEY=your-azure-openai-o1mini-api-key
AZURE_OPENAI_O1MINI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_O1MINI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Azure OpenAI Embeddings (REQUERIDO si generate_embeddings=true)
# Opciones: text-embedding-ada-002, text-embedding-3-small, text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Azure OpenAI Vision (opcional, para análisis de imágenes en XLSX)
# Si no se especifica, se usará el mismo deployment que AZURE_OPENAI_DEPLOYMENT_NAME
# Recomendado: usar un modelo con capacidad de visión como gpt-4o, gpt-4-vision, etc.
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1000

# ===== PostgreSQL tradicional (Para desarrollo local) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_SSL=disable
USE_IAM_AUTH=false
AWS_REGION=us-east-2

# Multi-tenant (opcional)
# Aurora DSQL solo permite una DB, así que usamos SCHEMAS para multi-tenant
# Si CLIENT_ID se provee, se crea/usa un schema específico: kb_{CLIENT_ID}
# Ejemplo: CLIENT_ID=empresa1 → schema: kb_empresa1 (dentro de DB 'postgres')
CLIENT_ID=empresa_1
POSTGRES_SCHEMA_PREFIX=kb_  # Prefijo para schemas multi-tenant

# Auto-provisioning
# Si true, crea automáticamente la DB y tablas si no existen
# Si false, falla si la DB/tablas no existen (requiere setup manual)
POSTGRES_AUTO_CREATE=true

# Configuración de guardado automático
SAVE_TO_KNOWLEDGE_BASE=true  # Si false, solo estandariza sin guardar